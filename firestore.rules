rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Acesso inicial restrito à conta administrativa cadastrada no Firebase Auth.
    // Não substitua por allow read, write: if true.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == '1ryCbJM0KvNSRCaPbzgGM4gcM7v2';
    }
  }
}
